# Copy to `.env.local` for local development. Never commit `.env.local` or real secrets.

# Backend API base URL (no trailing slash). Omit to use http://localhost:4000 in dev.
VITE_API_URL=http://localhost:4000

# ─── AI Тьютор (бесплатно) ───────────────────────────────────────────────────
# Google Gemini — бесплатный тариф, хороший русский язык
# 1. Откройте https://aistudio.google.com/apikey
# 2. Войдите через Google → «Create API key»
# 3. Вставьте ключ ниже и в Vercel → Settings → Environment Variables
GEMINI_API_KEY=your-gemini-api-key-here

# Модель (бесплатные): gemini-1.5-flash (рекомендуется) или gemini-2.0-flash
# GEMINI_MODEL=gemini-1.5-flash
