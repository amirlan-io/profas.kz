# Copy to `.env.local` for local development. Never commit `.env.local` or real secrets.

# Backend API base URL (no trailing slash). Omit to use http://localhost:4000 in dev.
VITE_API_URL=http://localhost:4000

# OpenAI — server-side only (Vercel → Settings → Environment Variables, or .env.local for npm run dev)
OPENAI_API_KEY=sk-your-openai-api-key
# Optional:
# OPENAI_MODEL=gpt-4o-mini
