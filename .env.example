# Copy to `.env.local` for local development. Never commit `.env.local` or real secrets.
#
# Variables prefixed with VITE_ are baked into the client bundle at build time.
# Do not put private API keys here — only public base URLs for your backend.

# Backend API base URL (no trailing slash). Omit to use http://localhost:4000 in dev.
VITE_API_URL=http://localhost:4000
