# Copy to `.env.local` for local development. Never commit `.env.local`.

VITE_API_URL=http://localhost:4000

# ─── AI Тьютор (рекомендуется Groq — стабильный бесплатный лимит) ─────────────
# 1. https://console.groq.com/keys → Create API Key (бесплатно)
# 2. Vercel → Settings → Environment Variables → GROQ_API_KEY
GROQ_API_KEY=gsk_your_groq_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# Запасной вариант — Google Gemini (лимит быстро кончается на публичном сайте)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash-lite
